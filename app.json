{
  "expo": {
    "name": "LockInPhase",
    "slug": "lockinphase",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lockinphase",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0D0C0B"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lockinphase.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0C0B"
      },
      "package": "com.lockinphase.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E8B33C"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/lockinphase"
    }
  }
}
